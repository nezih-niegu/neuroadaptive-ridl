   keywords = {Cooperation and Collaboration in Human-Robot Teams,Machine Learning and Adaptation,Medical and Surgical Applications},
   title = {Collaborative Suturing: A Reinforcement Learning Approach to Automate Hand-off Task in Suturing for Surgical Robots},
   year = {2020},
